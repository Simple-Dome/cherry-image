# 本地从主项目运行 npm run dev:all 时使用 http://localhost:5173/manual/index.html
# 生产构建通过 Docker --build-arg 覆盖为正式地址。
NEXT_PUBLIC_DOC_URL=https://gptch.cloud/image/manual/index.html

# 本地上传服务地址。配置后前端会直传此服务；不配置则使用 /api/uploads/sign 走对象存储。
# NEXT_PUBLIC_UPLOAD_BASE=http://localhost:8788

# 线上对象存储上传。Bucket 需要允许 publicUrl 公共读，并配置 image-inputs/、video-inputs/、audio-inputs/ 30 天生命周期删除。
# UPLOAD_STORAGE_ENDPOINT=https://example-account.r2.cloudflarestorage.com
# UPLOAD_STORAGE_REGION=auto
# UPLOAD_STORAGE_BUCKET=your-bucket
# UPLOAD_STORAGE_ACCESS_KEY_ID=your-access-key
# UPLOAD_STORAGE_SECRET_ACCESS_KEY=your-secret-key
# UPLOAD_STORAGE_FORCE_PATH_STYLE=false
# UPLOAD_PUBLIC_BASE=https://pub-example.r2.dev
# UPLOAD_MAX_BYTES=524288000
# UPLOAD_PRESIGN_EXPIRES_SECONDS=900
